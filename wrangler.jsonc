// Cloudflare Workers config. Cloudflare serves the built app in dist/ directly;
// only /api/* runs the Worker script (worker/index.ts), which keeps synced
// practice history in a D1 database.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "e-drum-practice-coach",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths get index.html, so client-side routes added later work on reload.
    "not_found_handling": "single-page-application",
    // Everything else never reaches the script, so the app is served as before.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // The API only answers here. Previews share this Worker's database, so
    // they get 503 instead (see worker/index.ts). For `wrangler dev`, override
    // it in .dev.vars with APP_ORIGIN=http://localhost:8787.
    "APP_ORIGIN": "https://e-drum-practice-coach.eduardafa.workers.dev",
    // OAuth client IDs are public (they appear in the sign-in URL). The matching
    // secrets are set with `wrangler secret put GITHUB_CLIENT_SECRET` (and
    // GOOGLE_CLIENT_SECRET). A provider without both stays hidden.
    "GITHUB_CLIENT_ID": "Ov23li1mOUnX2p0O2p0h",
    "GOOGLE_CLIENT_ID": "646327812271-uc1kvovvgrmekdqmfq7kdlrgtqgttito.apps.googleusercontent.com",
    // Accounts that can use AI insights, as provider:account-number (EDU-53).
    // The Claude API key is a secret: ANTHROPIC_API_KEY.
    "AI_ALLOWED": "github:54603419"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "e-drum-practice-coach",
      "database_id": "b37bf9e3-d0f8-4834-9359-3bf530cfa1be",
      // Applied by CI before each production deploy.
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare's rate limiting (per location, approximate): sync calls per
  // account, and sign-in attempts per IP address. Over the limit, 429.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // Production lives on workers.dev; pull requests get aliased version URLs there too.
  "workers_dev": true,
  "preview_urls": true
}
