# Applied by Cloudflare to every static asset response (see wrangler.jsonc).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com https://*.googleusercontent.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Permissions-Policy: midi=(self), camera=(), microphone=(), geolocation=(), payment=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# Vite puts a content hash in every file name under /assets, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
