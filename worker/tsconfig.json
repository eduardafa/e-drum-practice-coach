{
  // The Worker runs in workerd, not a browser: its globals come from the
  // generated worker-configuration.d.ts (`pnpm types:worker`), without DOM.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts", "vite/client"]
  },
  "include": ["./**/*.ts"]
}
